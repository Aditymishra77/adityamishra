{
  "name": "cursorforge-ide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:host": "next dev --hostname 0.0.0.0 --port 3000",
    "docker:up": "docker compose up --build",
    "api:dev": "tsx watch server/src/server.ts",
    "api:start": "tsx server/src/server.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run api:dev\""
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "next": "14.2.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.25",
    "typescript": "5.6.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.11.11"
  }
}
